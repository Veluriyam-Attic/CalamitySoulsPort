	ManicTalisman: {
		Tooltip:
			'''
			激活脑瘫模式，让NPC的速度和ai速度乘150%，减少30%NPC受到伤害，你多受到50%伤害
			你的肾上腺素伤害增加50%，你的防御阻挡0.5伤害而非0.75
			击败任意boss前且没有boss存在时，NPC的AI速度和免伤增幅被取消
			只能在复仇模式下使用
			'''
		DisplayName: 欠抽护符
	}

