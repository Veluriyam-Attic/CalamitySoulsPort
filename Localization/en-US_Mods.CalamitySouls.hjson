	CSConfigMisc: {
		DisplayName: （杂项）

		DisableSoulSpeed: {
			Label: 禁用灾厄之魂的移速加成
			Tooltip:
				'''
				开启后，本模组（魔石 / 之力 / 咒 / 魂）提供的移动速度加成全部失效。
				用于最终形态移速过快、难以控制的情况。其它效果不受影响。
				'''
		}

		AllowMixedSouls: {
			Label: 允许新旧魂同时装备
			Tooltip:
				'''
				默认关闭。关闭时：只限制最顶层的「魂」——旧版之魂与新版的魂不能同时佩戴；
				魔石、之力与饰品可以随意混搭，不受影响。
				'''
		}
	}
}
