	CovidVaccines: {
		DisplayName: 中国新冠疫苗
		Tooltip:
			'''
			医生：“中国新冠疫苗提供74.8%的保护。”
			观众：“才75%？这么少的吗？”
			医生：“这还少？80%不感染，感染99%不发病，发病100%不转重症。”
			医生：“换句话说，80%闪避几率，加99%免伤还免疫暴击。”
			医生：“这妥妥神器啊！”
			所以就有了这个物品
			80%几率闪避攻击，减少99%受到伤害并且100%不会被暴击
			'''
	}

