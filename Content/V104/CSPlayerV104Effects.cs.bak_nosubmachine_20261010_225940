		// ---- 掠夺者·防御档：近战命中吸血（1.3 CSPlayerEffects.cs:767-797 逐值照搬）----
		// 1.3：lifeRegenTime++；10% 概率；仅近战（proj == null）；heal = damage*0.2 上限 10；
		//      lifeSteal -= heal*3；在 255 个玩家中选"1200 像素内、血量差最大"的队友作为治疗目标；
		//      然后 NewProjectile(target.Center, Vector2.Zero, ReaverHealOrb, 0, 0f, owner, healTarget, heal)
		public static void OnHitNPCWithItem(Player player, NPC target, int damage)
		{
			CSPlayerV104 mplayer = player.V104();
			if (!mplayer.ReaverDefense) return;
			player.lifeRegenTime++;
			if (Main.rand.Next(10) != 0) return;
			if (Main.player[Main.myPlayer].lifeSteal <= 0f || !target.canGhostHeal || player.moonLeech) return;
			float heal = damage * 0.2f;
			if (heal > 10f) heal = 10f;
			if ((int)heal <= 0 || Main.player[Main.myPlayer].moonLeech) return;
			Main.player[Main.myPlayer].lifeSteal -= heal * 3f;
			float lowestHealthCheck = 0f;
			int healTarget = player.whoAmI;
			for (int i = 0; i < 255; i++)
			{
				Player otherPlayer = Main.player[i];
				if (otherPlayer.active && !otherPlayer.dead
					&& ((!player.hostile && !otherPlayer.hostile) || player.team == otherPlayer.team)
					&& Vector2.Distance(target.Center, otherPlayer.Center) < 1200f
					&& (float)(otherPlayer.statLifeMax2 - otherPlayer.statLife) > lowestHealthCheck)
				{
					lowestHealthCheck = otherPlayer.statLifeMax2 - otherPlayer.statLife;
					healTarget = i;
				}
			}
			Projectile.NewProjectile(player.GetSource_FromThis(), target.Center, Vector2.Zero,
				ModContent.ProjectileType<ReaverHealOrbV104>(), 0, 0f, player.whoAmI, healTarget, heal);
		}

