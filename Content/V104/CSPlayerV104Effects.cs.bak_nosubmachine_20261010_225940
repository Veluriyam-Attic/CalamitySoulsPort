		// ===== 新版 CSUtils 里的三个 helper（2.x / 现有移植工程里没有，加在 V104 侧以免动旧代码）=====
		public static Vector2 ToDegreesVector2(float num, float mult = 1f, float add = 0f)
			=> MathHelper.ToRadians(num * mult + add).ToRotationVector2();
		public static Vector2 DirectionFromSafe(Entity entity, Vector2 pos)
		{
			Vector2 v = entity.DirectionFrom(pos);
			if (v.HasNaNs()) v = Vector2.Zero;
			return v;
		}
		public static Vector2 DirectionToSafe(Entity entity, Vector2 pos)
		{
			Vector2 v = entity.DirectionTo(pos);
			if (v.HasNaNs()) v = Vector2.Zero;
			return v;
		}
		public static NPC RealNPC(NPC npc) => npc.realLife >= 0 ? Main.npc[npc.realLife] : npc;

