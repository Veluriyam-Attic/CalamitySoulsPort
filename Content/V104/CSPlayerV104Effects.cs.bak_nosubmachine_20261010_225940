		// ---- 弑神者·古：受击传送闪避（1.3 PreHurt:602-659 逐值照搬）----
		// 1.4 说明：1.3 的 PreHurt 能拿到 damageSource；1.4 的 ModifyHurt 拿不到来源，
		//   故改用 1.4 的"完全闪避"钩子 ModPlayer.FreeDodge(Player.HurtInfo)：1.3 的 return false（取消伤害）
		//   ↔ 这里返回 true（闪避成功）；damage/damageSource 改取 info.Damage / info.DamageSource.SourceProjectileLocalIndex / SourceNPCIndex。
		public static bool GodslayerAncientFreeDodge(Player player, Player.HurtInfo info)
		{
			CSPlayerV104 mplayer = player.V104();
			CalamityPlayer cplayer = player.GetModPlayer<CalamityPlayer>();
			if (!(mplayer.GodslayerAncientTeleport && !player.chaosState && !cplayer.disableAllDodges)) return false;

			// ① 尘环：rand(4,8) 条射线 × 每条 rand(12,21) 粒 Dust 27
			float rnd = Main.rand.NextFloat(MathHelper.TwoPi);
			int rAmt = Main.rand.Next(4, 8);
			for (int j = 0; j < rAmt; j++)
			{
				int rLength = Main.rand.Next(12, 21);
				for (int i = 0; i < rLength; i++)
				{
					Vector2 dir = rnd.ToRotationVector2().RotatedBy(MathHelper.ToRadians(j * 360f / rAmt));
					Dust dust = Dust.NewDustPerfect(player.Center + 4 * i * dir, 27);
					dust.noGravity = true;
					dust.scale = 2.5f - System.Math.Abs(i * rLength / 20f) / 10f;
					dust.velocity = -System.Math.Sign(i) * dir * 1f;
					dust.color = Color.Black;
				}
			}
			// ② 黑洞（1.3 原设计：生成后设为【非友方】+ timeLeft 30 —— 照搬，不改）
			if (player.whoAmI == Main.myPlayer)
			{
				Projectile voidMatter = Projectile.NewProjectileDirect(player.GetSource_FromThis(), player.Center, Vector2.Zero,
					ModContent.ProjectileType<SealedSingularityBlackholeV104>(), 0, 0f, player.whoAmI);
				voidMatter.friendly = false;
				voidMatter.timeLeft = 30;
			}
			// ③ 传送目标：最多 5 次重试直到目标格不是实心砖
			Vector2 pos = player.Center + CSUtils.RandomRotate * Main.rand.Next(320, 640);
			for (int t2 = 0; t2 < 5; t2++)
			{
				if (!WorldGen.SolidTile(Main.tile[(int)(pos.X / 16), (int)(pos.Y / 16)])) break;
				pos = player.Center + CSUtils.RandomRotate * Main.rand.Next(320, 640);
			}
			player.Teleport(pos, 1);
			// ④ 50 粒 Shadowflame
			for (int m = 0; m < 50; m++)
			{
				Dust dust = Dust.NewDustDirect(player.position, player.width, player.height, DustID.Shadowflame);
				dust.position.X += Main.rand.Next(-20, 21);
				dust.position.Y += Main.rand.Next(-20, 21);
				dust.velocity *= 0.9f;
				dust.scale *= 1f + Main.rand.Next(40) * 0.01f;
				dust.color = Color.Black;
				if (Utils.NextBool(Main.rand, 2)) dust.scale *= 1f + Main.rand.Next(40) * 0.01f;
			}
			// ⑤ 音效（1.3: Main.PlaySound(SoundID.Item, x, y, 67, 1f, 0f) → 1.4 的 SoundID.Item67，已核实存在）
			SoundEngine.PlaySound(SoundID.Item67, player.position);
			player.AddBuff(BuffID.ChaosState, 10 * 60);
			player.SetImmunityTime(30);
			// ⑥ 反击来源：弹幕（带 1.3 的豁免判定 → 2.x ShouldNotBeReflected）
			if (info.DamageSource.SourceProjectileLocalIndex != -1)
			{
				Projectile hosPSource = Main.projectile[info.DamageSource.SourceProjectileLocalIndex];
				if (!CalamityMod.Systems.Collections.CalamityProjectileSets.ShouldNotBeReflected[info.DamageSource.SourceProjectileType])
					if (hosPSource.active)
						hosPSource.Kill();
			}
			// ⑦ 反击来源：NPC（1.3: StrikeNPCExtra(damage * 10, Color.Violet, player)）
			if (info.DamageSource.SourceNPCIndex != -1)
			{
				NPC hosNSource = Main.npc[info.DamageSource.SourceNPCIndex];
				if (hosNSource.active && !hosNSource.friendly && !hosNSource.dontTakeDamage)
					hosNSource.StrikeNPCExtra(info.Damage * 10, Color.Violet, player);
			}
			return true;   // 1.3: return false（闪避成功、取消本次伤害）
		}

