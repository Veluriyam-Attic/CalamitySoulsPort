		// 点到矩形的距离（1.3 灾厄 CSUtils.DistFromRectan 的等价实现，2.x 已无此扩展）
		public static float DistFromRectan(Vector2 point, Rectangle rect)
		{
			float dx = System.Math.Max(rect.Left - point.X, System.Math.Max(0f, point.X - rect.Right));
			float dy = System.Math.Max(rect.Top - point.Y, System.Math.Max(0f, point.Y - rect.Bottom));
			return (float)System.Math.Sqrt(dx * dx + dy * dy);
		}

		// ---- 星光魔石：攻击时在身前打出白金之拳（对应新版 UpdateAccMinions 里的 LuxAstriPunch 段）----
		private static void LuxAstriAttack(Player player, CSPlayerV104 mplayer)
		{
			bool holdingNothing = player.HeldItem.IsAir;
			if (!((player.itemAnimation > 0 && player.miscCounter % 5 == 0)
				|| (holdingNothing && player.controlUseItem && player.miscCounter % 2 == 0))) return;

			SoundEngine.PlaySound(SoundID.NPCHit15, player.Center);
			if (holdingNothing)
			{
				player.itemAnimation = 2;
				player.direction = Main.MouseWorld.X - player.Center.X > 0f ? 1 : -1;
			}
			if (player.whoAmI != Main.myPlayer) return;
			int dmg = HeldDamage(player, mplayer.AnnihilationEffect ? 250f : 25f);
			for (int i = 0; i < 2; i++)
			{
				Vector2 randpos = new Vector2(Main.rand.Next(20, 61), Main.rand.Next(10, 91));
				float poslength = 3 * randpos.X + 2 * randpos.Y;
				if (poslength > 480f) randpos /= 2f;
				if (Main.rand.Next(2) == 0) randpos.X *= -1;
				if (Main.rand.Next(2) == 0) randpos.Y *= -1;
				if (i == 0) randpos *= -1;
				Projectile.NewProjectile(player.GetSource_FromThis(), player.Center + randpos,
					player.DirectionTo(Main.MouseWorld) * 16f, ModContent.ProjectileType<LuxAstriPunchV104>(),
					dmg, 5f, player.whoAmI, 0f, i);
			}
		}

		// 对应新版 CSUtils.HeldDamage(originDamage) = originDamage * 手持物品的伤害倍率
		public static int HeldDamage(Player player, float originDamage)
		{
			Item item = player.HeldItem;
			float mult = 1f;
			if (!item.IsAir) mult = player.GetTotalDamage(item.DamageType).ApplyTo(1f);
			return (int)(originDamage * mult);
		}

		// ---- 绝灭魔石：给 500 像素内的生物与弹幕加更强的重力（对应新版 PostUpdateMiscEffects 里的两段）----
		public static void PostUpdateMiscEffects(Player player)
		{
			CSPlayerV104 mplayer = player.V104();
			bool statigelHasGraze = false;   // 斯塔提斯擦弹判定结果
			bool breakWulfrumField = false;   // 1.3：本帧力场是否被打破（打破则进 15 秒冷却）
			// ---- 日影：遁于暗影计时（1.3 PostUpdateMiscEffects:1124-1137 逐值照搬）----
			if (mplayer.CanUmbraphileShealth)
			{
				if (mplayer.UmbraphileShealth >= 10 * 60) mplayer.UmbraphileShealth = -1;
				if (mplayer.UmbraphileShealth >= 0)
				{
					mplayer.UmbraphileShealth++;
					if (player.itemAnimation > 0) mplayer.UmbraphileShealth = 0;
				}
			}
			else mplayer.UmbraphileShealth = 0;
			if (mplayer.UmbraphileShealth == -1)
			{
				player.AddBuff(ModContent.BuffType<Buffs.UmbraphileUndetectedV104>(), 2);
			}
			if (mplayer.SnowFreeze || mplayer.HydrothermicSolarCircle || mplayer.StatigelArea)
			{
				foreach (NPC npc in Main.npc)
				{
					if (!npc.active) continue;
					float distanceR = DistFromRectan(player.Center, npc.Hitbox);
					float distance = Vector2.Distance(player.Center, npc.Center);
					// 雪境暴徒：冰冻 200 像素内的敌人（沿用移植工程里已有的 CSNPC.Frozen 实现）
					if (mplayer.SnowFreeze && distanceR < 200f)
					{
						int time = (int)((1f - distanceR / 200f) * 300f);
						if (time > 180) time = 180;
						npc.CS().Frozen = time;
						if (!npc.friendly) npc.AddBuff(BuffID.Frostburn, time);
					}
					if (npc.friendly) continue;
					if (npc.dontTakeDamage) continue;
					// 斯塔提斯：生物擦弹（1.3 位于 npc.damage > 0 的块内）
					if (mplayer.StatigelArea && npc.damage > 0 && distanceR < 125f) statigelHasGraze = true;
					// 钨钢力场：把贴到力场上的敌人顶开（1.3 CSPlayerEffects:988-1008 逐值）
					if (mplayer.WulfrumField && mplayer.WulfrumFieldCooldown <= 0 && !breakWulfrumField && npc.damage > 0)
					{
						float distW = DistFromRectan(player.Center + MathHelper.ToRadians(mplayer.WulfrumFieldAnimationTimer * 30).ToRotationVector2(), npc.Hitbox);
						if (distW < 35f)
						{
							Vector2 dirW = DirectionFromSafe(npc, player.Center);
							if (dirW.HasNaNs()) dirW = -Vector2.UnitY;
							npc.Center = player.Center + dirW * (60f + (npc.width + npc.height) / 4f);
							if (Vector2.Dot(npc.velocity, dirW) < 0f)
							{
								npc.velocity = -npc.velocity * 0.8f;
								if (npc.velocity.Length() < 5f) npc.velocity.Length(5f);
							}
							else npc.velocity += dirW * 5f;
							npc.AddBuff(ModContent.BuffType<CalamityMod.Buffs.StatDebuffs.Eutrophication>(), 90);   // 1.3: npc.Calamity().eutrophication += 90（2.x 该字段不可写 → 改用其等价的富营养化减益；差异表已记）
							breakWulfrumField = true;
							for (int wi = 0; wi < 6; wi++)
							{
								Dust wd = Dust.NewDustPerfect(player.Center + dirW * 60f, DustID.Electric);
								wd.noGravity = Main.rand.Next(2) == 0;
								wd.scale *= Main.rand.NextFloat() + 1f;
							}
						}
					}
					// 渊泉：日炎环（1.3 逐值 —— 矩形距离 < 160 引爆；中距时把爆点压到 160 处；
					// 12 粒 SolarFlare 尘；伤害 Main.rand.Next(34,47) * (Annihilation ? 50 : 10)，
					// 乘 (1 - npc.DR)，下限 1；击退 10 * knockBackResist^0.5；冷却本体 4 帧 / 其他 15 帧）
					if (mplayer.HydrothermicSolarCircle && RealNPC(npc).CSV104().HydrothermicBurstCooldown <= 0 && distanceR < 160f)
					{
						Vector2 pos = npc.Center;
						if (distance > 160f) pos = player.Center + DirectionToSafe(player, npc.Center) * 160f;
						SoundEngine.PlaySound(SoundID.Item14 with { Volume = 1f / 3f }, pos);
						for (int i = 0; i < 12; i++)
						{
							Dust explosion = Dust.NewDustPerfect(pos, DustID.SolarFlare);
							explosion.noGravity = true;
							explosion.noLight = false;
							explosion.scale = 1.2f;
							explosion.velocity = CSUtils.RandomRotate * Main.rand.NextFloat(2.5f, 5f);
						}

						int amt = Main.rand.Next(34, 47) * (mplayer.AnnihilationEffect ? 50 : 10);
						amt = (int)(amt * (1 - npc.Calamity().DR));
						if (amt < 0) amt = 1;
						npc.StrikeNPCExtra(amt, new Color(224, 108, 29), player);
						npc.velocity += DirectionFromSafe(player, npc.Center) * 10f * (float)System.Math.Pow(npc.knockBackResist, 0.5f);

						if (npc.realLife > 0) RealNPC(npc).CSV104().HydrothermicBurstCooldown = 4;
						else npc.CSV104().HydrothermicBurstCooldown = 15;

						float rand = Main.rand.Next(0, 360);
						for (int i = 0; i < 36; i++)
						{
							Vector2 dir = ToDegreesVector2(i * 10 + rand);
							Dust dust = Dust.NewDustPerfect(player.Center + dir * 160f, DustID.SolarFlare);
							dust.noGravity = true;
							dust.noLight = true;
							dust.velocity = DirectionFromSafe(player, dust.position) * dust.velocity.Length() * 5f;
							dust.scale = 0.9f;
						}
					}
				}
			}
			// ---- 斯塔提斯：弹幕擦弹判定（1.3 PostUpdateMiscEffects:1031-1032 逐值）----
			if (mplayer.StatigelArea && !statigelHasGraze)
			{
				foreach (Projectile proj in Main.projectile)
				{
					if (!proj.active) continue;
					// 钨钢力场：清除力场矩形内的敌方弹幕（1.3 CSPlayerEffects:1033-1041）
					if (mplayer.WulfrumField && mplayer.WulfrumFieldCooldown <= 0 && !breakWulfrumField && proj.hostile)
					{
						Vector2 wfPos = player.Center + MathHelper.ToRadians(mplayer.WulfrumFieldAnimationTimer * 30).ToRotationVector2();
						Rectangle rectW = new Rectangle((int)(wfPos.X - 70f), (int)(wfPos.Y - 70f), 140, 140);   // 1.3: CSUtils.SpawnCenteredRectan(pos, 70)（我方 CSUtils 无该 helper → 内联等价）
						if (proj.Colliding(proj.Hitbox, rectW))
						{
							proj.Kill();
							breakWulfrumField = true;
						}
					}
					if (proj.hostile && DistFromRectan(player.Center, proj.Hitbox) < 125f)
					{
						statigelHasGraze = true;
						break;
					}
				}
			}
			// ---- 斯塔提斯：擦到就给 12% 增伤 Buff（30*30 帧）+ 90 帧无敌（1.3 PostUpdateMiscEffects:1097-1106 逐值）----
			// 钨钢力场自身：照明 + 冷却粒子 + 破碎后进 15 秒冷却（1.3 CSPlayerEffects:1138-1155 逐值）
			if (mplayer.WulfrumField)
			{
				Lighting.AddLight(player.Center, 0f, 1.5f, 1.5f);
				if (mplayer.WulfrumFieldCooldown > 0 && Main.rand.Next(3) == 0)
				{
					Dust wd = Dust.NewDustDirect(player.Center - new Vector2(20), 40, 40, DustID.Electric);
					wd.noGravity = Main.rand.Next(2) == 0;
					wd.scale *= Main.rand.NextFloat() + 1f;
					wd.velocity = DirectionFromSafe(player, wd.position) * 2f;
				}
				if (breakWulfrumField)
				{
					mplayer.WulfrumFieldCooldown = 15 * 60;
					for (int wi = 0; wi < 20; wi++)
					{
						Dust wd = Dust.NewDustDirect(player.Center - new Vector2(60f), 120, 120, DustID.Electric);
						wd.noGravity = Main.rand.Next(2) == 0;
						wd.scale *= Main.rand.NextFloat() + 1f;
					}
				}
			}
			if (mplayer.StatigelArea && statigelHasGraze)
			{
				int dmgBoostType = ModContent.BuffType<Buffs.StatigelDamageBuffV104>();
				if (player.FindBuffIndex(dmgBoostType) == -1)
				{
					player.AddBuff(dmgBoostType, 30 * 30);
					player.SetImmunityTime(90);
				}
			}
			if (!mplayer.ExterminationGravity) return;
			foreach (NPC npc in Main.npc)
			{
				if (!npc.active || npc.realLife == -1) continue;
				float distanceR = Vector2.Distance(player.Center, npc.Center);
				if (distanceR < 500f)
				{
					float gravity = npc.boss ? 0.02f : 0.2f;
					float airResistance = npc.boss ? 0.995f : 0.98f;
					npc.velocity.Y += gravity;
					npc.velocity *= airResistance;
				}
			}
			foreach (Projectile proj in Main.projectile)
			{
				if (!proj.active) continue;
				float distance = Vector2.Distance(player.Center, proj.Center);
				if (distance < 500f)
				{
					// 1.3 用 Calamity 的 CouldBeCleared() 分类；这里以其语义近似：敌对弹幕按"可清除"处理
					float gravity = proj.hostile ? 0.04f : 0.01f;
					float airResistance = proj.hostile ? 0.995f : 0.998f;
					proj.velocity.Y += gravity;
					proj.velocity *= airResistance;
				}
			}
		}

		// ---- 星流魔石：受到伤害后给 10 秒力场 Buff（对应新版 PostHurt）----
		public static void PostHurt(Player player)
