						Projectile.NewProjectile(player.GetSource_FromThis(), player.Center, Vector2.Zero, option, 0, 0f, player.whoAmI, 0, i * 60);
				}
			}			if (mplayer.ForceAnnihilation)
			{
				mplayer.AnnihilationEffect = true;   // 1.3 捆绑激活
				mplayer.EnchLuxAstri = true;   // 1.3 捆绑激活
