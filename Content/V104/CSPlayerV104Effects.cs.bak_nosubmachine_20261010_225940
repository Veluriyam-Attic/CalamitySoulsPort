		// ---- 欧米伽蓝：敌人护甲越高你伤害越高（近战分支；弹幕分支在 CSProjectileV104）----
		// 两条钩子在 1.4 里是互斥的：ModifyHitNPCWithItem 只在"物品直接命中"时跑，
		// GlobalProjectile.ModifyHitNPC 只在"弹幕命中"时跑，同一次命中不会两条都走。
		public static void ModifyHitNPCWithItem(Player player, NPC target, ref NPC.HitModifiers modifiers)
		{
			CSPlayerV104 mplayer = player.V104();
			if (mplayer.OmegaDefenseBreak) modifiers.FlatBonusDamage += target.defDamage * 0.5f;
			// 圣蚀 / 硫磺：近战直接命中使敌人辐射（对应新版 OnHitNPCWithAnything）
			if (mplayer.EnchAcidivine || mplayer.SulphurousPoison) target.Calamity().irradiated = true;
		}

		// ---- 星流魔石：力场存在时单次伤害不超过 50，挡一次后破碎并炸出 8 片碎片（对应新版 PreHurt 的 ExoShieldActive 段）----
		public static void ModifyHurt(Player player, ref Player.HurtModifiers modifiers)
		{
			CSPlayerV104 mplayer = player.V104();

			// ---- 代达罗斯：闪避（1.3 PreHurt:587-601 逐值照搬）----
			if (mplayer.DaedalusEvade && !mplayer.DaedalusEvadeCooldown
				&& !player.GetModPlayer<CalamityPlayer>().disableAllDodges)
			{
				if (player.whoAmI == Main.myPlayer)
				{
					for (int i = 0; i < 12; i++)
					{
						Vector2 rotate = MathHelper.ToRadians(i * 30f).ToRotationVector2();
						Projectile shard = Projectile.NewProjectileDirect(player.GetSource_FromThis(),
							player.Center + rotate * 16f, rotate * 10f,
							ModContent.ProjectileType<DaedalusIcicleV104>(), HeldDamage(player, 200f), 12f, player.whoAmI);
						shard.GetPlayerDamageType(player);
						shard.timeLeft = 530;
					}
				}
				player.AddImmunityTime(player.longInvince ? 4 * 60 : 2 * 60);
				player.AddBuff(ModContent.BuffType<Buffs.DaedalusEvadeCooldownV104>(), 60 * 60);
				modifiers.FinalDamage *= 0f;   // 1.3: return false（闪避 → 伤害归零）
				return;
			}

			// ---- 日影：遁于暗影时闪避一次（1.3 PreHurt:661-693 逐值照搬）----
			if (mplayer.CanUmbraphileShealth && mplayer.UmbraphileShealth == -1
				&& !player.GetModPlayer<CalamityPlayer>().disableAllDodges)
			{
				player.AddImmunityTime(4 * 60);
				for (int i = 0; i < 32; i++)
				{
					Vector2 dir = MathHelper.ToRadians(i / 32f * 360f).ToRotationVector2();
					Dust flame = Dust.NewDustPerfect(player.Center + dir, DustID.GoldFlame);
					flame.noGravity = true;
					flame.velocity = dir * 4f;
					flame.scale = 2.4f;
					Dust dark = Dust.NewDustPerfect(player.Center, DustID.AncientLight);
					dark.noGravity = true;
					dark.noLight = true;
					dark.velocity = dir * 3f;
					dark.scale = 1.6f;
					dark.color = Color.Black;
				}
				for (int i = 0; i < 8; i++)
				{
					for (int j = 0; j < 4; j++)
					{
						Vector2 dir = MathHelper.ToRadians(i * 45f).ToRotationVector2() * 1.2f;
						if (i % 2 == 0) dir *= 1.2f;
						dir *= (4 + j) / 4f;
						Dust flame = Dust.NewDustPerfect(player.Center + dir, DustID.GoldFlame);
						flame.noGravity = true;
						flame.velocity = dir * 4f;
						flame.scale = 2.4f;
					}
				}
				mplayer.UmbraphileShealth = 0;
				modifiers.FinalDamage *= 0f;   // 1.3: return false（闪避 → 伤害归零）
				return;
			}

			if (!mplayer.ExoShieldActive) return;
			const float cap = 50f;
			if (modifiers.FinalDamage.Base <= cap) return;

			modifiers.FinalDamage.Base = cap;
			player.ClearBuff(ModContent.BuffType<ExoShieldBuffV104>());
			player.buffImmune[ModContent.BuffType<ExoShieldBuffV104>()] = true;

			if (player.whoAmI != Main.myPlayer) return;
			// 1.3 用命中来源索引取方向；1.4 的 HurtModifiers 暴露 HitDirection，这里用它近似
			Vector2 hitDir = new Vector2(modifiers.HitDirection, 0f);
			float radius = player.miscCounter % 100;
			if (radius > 50) radius = 100 - radius;
			for (int i = 0; i < 8; i++)
			{
				Vector2 dir = MathHelper.ToRadians(i * 45f).ToRotationVector2();
				Projectile shard = Projectile.NewProjectileDirect(player.GetSource_FromThis(), player.Center + dir * 30f,
					dir * 5f + hitDir * 13f, ModContent.ProjectileType<ExoShieldShardV104>(), 0, 0f, player.whoAmI, i);
				shard.rotation = dir.ToRotation();
				shard.scale = 0.8f + radius / 200f;
			}
		}
	}
}
