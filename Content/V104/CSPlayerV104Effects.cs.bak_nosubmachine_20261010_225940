		// 1.3 CSUtils 的等价 helper（2.x / 现有移植工程里没有，加在 V104 侧）
		public static float AngleToSafe(Entity entity, Vector2 pos) => DirectionToSafe(entity, pos).ToRotation();
		// 1.3 CSUtils.Wrap(value, min, max) 的等价实现（把 value 折回 [min, max) 区间）
		public static float Wrap(float value, float min, float max)
		{
			float range = max - min;
			if (range <= 0f) return min;
			return value - range * (float)System.Math.Floor((value - min) / range);
		}
